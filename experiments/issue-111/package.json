{
  "name": "issue-111-continuity-experiment",
  "private": true,
  "version": "0.0.0",
  "description": "Throwaway harness comparing Pi native session resume and pi-durable for worker continuity (issue #111). Isolated: not part of the factory build or test path.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-timeout=120000 \"dist/**/*.test.js\"",
    "run:scenarios": "npm run build && node dist/run.js"
  },
  "devDependencies": {
    "@types/node": "22.18.13",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0"
  }
}
