{
  "name": "my-software-factory",
  "version": "2.0.0-alpha.1",
  "workerImage": "msf-v2-worker:local",
  "description": "msf-v2: the minimal software factory — one headless orchestrator that drains a pool of works into PRs",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "msf": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:image": "docker build --build-arg AGENT_UID=$(id -u) --build-arg AGENT_GID=$(id -g) -t $(node -p \"require('./package.json').workerImage\") docker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gateway": "node scripts/quality-gateway.mjs",
    "test": "npm run build && npm run test:built",
    "test:built": "node --test --test-timeout=60000 --test-force-exit \"dist/**/*.test.js\"",
    "proof:real": "export MSF_REAL_PROOF=1 && npm run build && node --test --test-timeout=14400000 dist/e2e/sandcastle-real.test.js",
    "smoke:github": "npm run build && node dist/tracker/github-smoke.js"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@deepseek-ai/node-addon-system": "0.1.2",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
