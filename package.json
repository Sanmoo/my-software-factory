{
  "name": "my-software-factory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-suppressions.mjs src test",
    "verify": "npm run typecheck && npm run lint && npm test",
    "test": "tsx --test test/*.test.ts",
    "msf": "tsx src/cli/msf.ts",
    "logs": "tsx src/cli/logs.ts",
    "reply": "tsx src/cli/supervision.ts reply",
    "resume": "tsx src/cli/supervision.ts resume",
    "release": "tsx src/cli/supervision.ts release",
    "approve": "tsx src/cli/supervision.ts approve",
    "pause": "tsx src/cli/supervision.ts pause",
    "unpause": "tsx src/cli/supervision.ts unpause",
    "smoke:pi": "tsx src/experiments/pi-smoke.ts",
    "smoke:implement": "tsx src/experiments/implement-help-smoke.ts",
    "smoke:docker": "tsx src/experiments/docker-spike/docker-spike.ts",
    "smoke:docker-runner": "tsx src/experiments/docker-runner-demo.ts",
    "smoke:herdr-pi": "tsx src/experiments/herdr-pi-proof.ts",
    "smoke:assist-session": "tsx src/experiments/assist-session-demo.ts",
    "smoke:assist-reconcile": "tsx src/experiments/assist-reconcile-demo.ts",
    "conformance:jira": "tsx src/experiments/jira-conformance.ts"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "ink": "^8.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "oxc-parser": "0.117.0",
    "oxlint": "1.87.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
