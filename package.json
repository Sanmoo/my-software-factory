{
  "name": "my-software-factory",
  "version": "2.0.0-alpha.1",
  "description": "msf-v2: the minimal software factory — one headless orchestrator that drains a pool of works into PRs",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "msf": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-timeout=5000 --test-force-exit \"dist/**/*.test.js\""
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
